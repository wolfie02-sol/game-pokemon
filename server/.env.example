# Copy to .env (never commit .env) or set these on your host.

# 'mock' = pretend blockchain for testing. 'solana' = real checks and transfers.
CHAIN=mock
# Stay on devnet until you have legal sign-off and are ready to send real cards.
SOLANA_CLUSTER=devnet
# Optional: a paid RPC (Helius, QuickNode, Alchemy) is far more reliable than the free public one.
SOLANA_RPC_URL=

# Your token's mint address once it launches. Empty = token gate OFF.
GATE_MINT=
GATE_MIN=10000

# Prize wallet secret key (from `npm run new-wallet`). Keep only a few cards in this wallet.
PRIZE_WALLET_SECRET=

# Make these long and random.
SESSION_SECRET=
ADMIN_PASSWORD=

# Your game's address(es), comma separated.
ALLOWED_ORIGINS=http://localhost:5173

# Limits
MAX_WINS_PER_DAY=3
MAX_WINS_PER_WALLET=1

PORT=8787
DB_PATH=./data/rewards.db
