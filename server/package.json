{
  "name": "wildkin-card-rewards",
  "private": true,
  "version": "0.1.0",
  "description": "Backend that rewards Wildkin players with Collector Crypt cards.",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "new-wallet": "node scripts/new-wallet.js",
    "mint-test-card": "node --env-file-if-exists=.env scripts/mint-test-card.js"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.1.1",
    "@metaplex-foundation/mpl-token-metadata": "^3.2.1",
    "@metaplex-foundation/umi": "^0.9.2",
    "@metaplex-foundation/umi-bundle-defaults": "^0.9.2"
  }
}
